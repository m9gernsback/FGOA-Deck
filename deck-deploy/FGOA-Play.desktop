[Desktop Entry]
Type=Application
Name=FGOA Play
Name[zh_CN]=FGOA 一键游玩
Comment=Start local server and run Fate/Grand Order Arcade
Comment[zh_CN]=启动本地服务器并运行 Fate/Grand Order Arcade
# 脚本与本文件都放在 ~/Desktop/FGOA/ 下；若目录不同请修改下面路径
Exec=konsole --hold -e bash /home/deck/Desktop/FGOA/fgoa-play.sh
Icon=applications-games
Terminal=false
Categories=Game;
