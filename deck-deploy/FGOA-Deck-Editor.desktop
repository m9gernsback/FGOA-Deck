[Desktop Entry]
Type=Application
Name=FGOA Deck Editor
Name[zh_CN]=FGOA 卡组编辑器
Comment=Browse cards and edit deck.json for Fate/Grand Order Arcade
Comment[zh_CN]=浏览卡图并编辑 ago.exe 读取的卡组（deck.json）
# 脚本与本文件都放在 ~/Desktop/FGOA/ 下；若目录不同请修改下面路径
Exec=konsole --hold -e bash -c 'cd /home/deck/Desktop/FGOA/carddeck && python3 server.py'
Icon=applications-games
Terminal=false
Categories=Game;
